generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RouteStatus {
  PENDING
  RECEIVED
  RETURNED
  COMPLETED
}

enum OrganizationType {
  REGIONAL
  PENRO
  CENRO
}

enum OfficeCategory {
  REGULAR
  RECORDS
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CommunityType {
  CHANNEL
  DIRECT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum ClientApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_REQUIREMENTS
  RESUBMITTED
  ACCEPTED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ClientApplicationAttachmentType {
  LETTER_REQUEST
  SUPPORTING_DOCUMENT
}

enum ClientApplicationKind {
  APPLICATION
  DOCUMENT_REQUEST
  FOLLOW_UP
  GENERAL_INQUIRY
}

enum DocumentSourceClass {
  INTERNAL
  EXTERNAL
}

enum InternalSourceScope {
  LOCAL_CARAGA
  OTHER_REGION
  CENTRAL_OFFICE
}

enum DocumentMonitoringCategory {
  GENERAL
  PERMIT
  SURVEY_RETURN
}

enum DocumentRoutingProfile {
  STANDARD
  DIRECT_TO_ACTION_OFFICE
}

enum DocumentPriority {
  LOW
  ROUTINE
  URGENT
  IMMEDIATE
}

enum DocumentClassification {
  UNCLASSIFIED
  SIMPLE
  COMPLEX
  HIGHLY_TECHNICAL
}

enum DocumentDelayReason {
  AWAITING_DOCUMENTS
  FOR_REVIEW_EVALUATION
  FOR_SIGNATURE_APPROVAL
  RETURNED_FOR_REVISION
  EXTERNAL_PARTY_AGENCY
  FIELD_VALIDATION_INSPECTION
}

enum DocumentActionType {
  APPROPRIATE_ACTION
  REVIEW_EVALUATION
  INFORMATION_REFERENCE
  COMPLIANCE
  SIGNATURE_APPROVAL
  REFER
  REVIEW_RECOMMENDATION
  COORDINATION
  DRAFT_REPLY
  RETURN_FOR_REVISION
  REFER_TO_DIVISION
  ASSIGN_TO_SECTION
  PREPARE_REPLY_OUTPUT
  INSPECTION_FIELD_ACTION
  COMPLIANCE_SUBMISSION
  CLOSE_FILE
  RETURN_TO_DIVISION
}

model User {
  id           String  @id @default(uuid())
  employeeId   String? @unique
  firstName    String
  lastName     String
  email        String  @unique
  username     String  @unique
  mobileNumber String?
  passwordHash String

  profileImageUrl String?
  profileImageId  String? // Cloudinary public_id

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles           UserRole[]
  offices         OfficeUser[]
  documentActions DocumentAction[]

  createdDocuments Document[] @relation("DocumentCreator")

  sentRoutes     DocumentRoute[] @relation("RouteSender")
  receivedRoutes DocumentRoute[] @relation("RouteReceiver")

  logs                 DocumentLog[]
  notifications        Notification[]
  settings             UserSettings?
  ownedCommunities     Community[]        @relation("CommunityOwner")
  communityMemberships CommunityMember[]
  communityMessages    CommunityMessage[]
  communityReads       CommunityRead[]
  messageReactions     MessageReaction[]
}

model UserSettings {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  darkMode           Boolean @default(false)
  notificationSounds Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users UserRole[]
}

model UserRole {
  id String @id @default(uuid())

  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model OrganizationUnit {
  id          String             @id @default(uuid())
  code        String             @unique
  name        String
  type        OrganizationType
  description String?
  parentId    String?
  parent      OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children    OrganizationUnit[] @relation("OrganizationHierarchy")

  offices Office[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Office {
  id          String         @id @default(uuid())
  officeCode  String         @unique
  officeName  String
  category    OfficeCategory @default(REGULAR)
  description String?

  organizationUnitId String
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id])

  users              OfficeUser[]
  documentActions    DocumentAction[]
  clientServiceTypes ClientServiceType[]
  clientApplications ClientApplication[]

  currentDocuments     Document[] @relation("CurrentOffice")
  senderDocuments      Document[] @relation("SenderOffice")
  responsibleDocuments Document[] @relation("ResponsibleOffice")

  sentRoutes     DocumentRoute[] @relation("FromOffice")
  receivedRoutes DocumentRoute[] @relation("ToOffice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeUser {
  id String @id @default(uuid())

  officeId String
  userId   String

  designation   String?
  isOfficeAdmin Boolean @default(false)

  office Office @relation(fields: [officeId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([officeId, userId])
}

model DocumentType {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  documents Document[]
}

model DocumentStatus {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  documents Document[]
}

model Document {
  id String @id @default(uuid())

  trackingNumber String @unique

  documentTypeId  String
  currentStatusId String
  currentOfficeId String

  senderType         String?
  senderOfficeId     String?
  senderName         String?
  senderOrganization String?
  senderContact      String?
  addressee          String?

  // ==============================
  // DOCUMENT CLASSIFICATION
  // ==============================

  sourceClass DocumentSourceClass?

  internalSourceScope InternalSourceScope?

  monitoringCategory DocumentMonitoringCategory @default(GENERAL)

  routingProfile DocumentRoutingProfile @default(STANDARD)

  title       String
  description String?

  referenceNumber String?

  createdById String

  responsibleOfficeId String?
  responsiblePerson   String?

  priority             DocumentPriority?
  confidentialityLevel String?
  classification       DocumentClassification?

  delayReason DocumentDelayReason?

  receivedAt DateTime?

  deadline DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deadlineReminderSent Boolean  @default(false)

  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  currentStatus DocumentStatus @relation(fields: [currentStatusId], references: [id])

  currentOffice Office @relation("CurrentOffice", fields: [currentOfficeId], references: [id])

  senderOffice Office? @relation("SenderOffice", fields: [senderOfficeId], references: [id])

  responsibleOffice Office? @relation("ResponsibleOffice", fields: [responsibleOfficeId], references: [id], onDelete: SetNull)

  createdBy User @relation("DocumentCreator", fields: [createdById], references: [id])

  clientApplication ClientApplication?

  attachments DocumentAttachment[]
  actions     DocumentAction[]
  routes      DocumentRoute[]
  logs        DocumentLog[]

  @@index([responsibleOfficeId])
  // NEW INDEXES
  @@index([sourceClass])
  @@index([internalSourceScope])
  @@index([monitoringCategory])
  @@index([routingProfile])
}

model DocumentAttachment {
  id String @id @default(uuid())

  documentId String

  fileName String
  filePath String
  mimeType String?
  fileSize Int?
  publicId String?

  uploadedAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentRoute {
  id String @id @default(uuid())

  documentId String

  fromOfficeId String
  toOfficeId   String

  sentByUserId     String
  receivedByUserId String?

  status RouteStatus @default(PENDING)

  remarks String?

  sentAt      DateTime  @default(now())
  receivedAt  DateTime?
  completedAt DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fromOffice Office @relation("FromOffice", fields: [fromOfficeId], references: [id])

  toOffice Office @relation("ToOffice", fields: [toOfficeId], references: [id])

  sentBy User @relation("RouteSender", fields: [sentByUserId], references: [id])

  receivedBy User? @relation("RouteReceiver", fields: [receivedByUserId], references: [id])
}

model DocumentLog {
  id String @id @default(uuid())

  documentId String
  userId     String

  action      String
  description String?

  ipAddress String?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id String @id @default(uuid())

  userId String

  title   String
  message String

  type String // EMAIL | SMS | SYSTEM

  isRead Boolean @default(false)

  documentId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Community {
  id String @id @default(cuid())

  name String

  description String?

  type CommunityType @default(CHANNEL)

  isGeneral Boolean @default(false)

  isPrivate Boolean @default(false)

  ownerId String?

  owner User? @relation("CommunityOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())

  members CommunityMember[]

  messages CommunityMessage[]
  reads    CommunityRead[]
}

model CommunityMember {
  id String @id @default(cuid())

  communityId String

  userId String

  role MemberRole @default(MEMBER)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([communityId, userId], name: "communityId_userId")
}

model CommunityMessage {
  id String @id @default(cuid())

  message String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  editedAt DateTime?

  isDeleted Boolean @default(false)

  userId String

  communityId String

  user User @relation(fields: [userId], references: [id])

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  reactions MessageReaction[]

  attachments CommunityAttachment[]
}

model CommunityRead {
  id String @id @default(cuid())

  communityId String
  userId      String

  lastReadAt DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId], name: "communityId_userId")
}

model MessageReaction {
  id String @id @default(cuid())

  messageId String
  userId    String

  emoji String

  createdAt DateTime @default(now())

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model CommunityAttachment {
  id String @id @default(cuid())

  messageId String

  fileName     String
  originalName String

  mimeType String

  fileSize Int

  path String

  createdAt DateTime @default(now())

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model DocumentAction {
  id String @id @default(uuid())

  documentId String
  userId     String
  officeId   String

  actionType DocumentActionType?

  comment String?

  fileName String?
  filePath String?
  fileType String?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  office   Office   @relation(fields: [officeId], references: [id])

  @@index([documentId])
  @@index([userId])
  @@index([officeId])
  @@index([actionType])
}

model Client {
  id String @id @default(cuid())

  firstName  String
  middleName String?
  lastName   String
  suffix     String?

  email        String  @unique
  mobileNumber String?
  address      String?

  organizationName String?

  passwordHash String

  status ClientStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?

  emailVerificationToken       String?
  emailVerificationTokenExpiry DateTime?

  applications ClientApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([status])
}

model ClientApplication {
  id String @id @default(cuid())

  referenceNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  transactionType String

  title       String
  description String?
  kind        ClientApplicationKind @default(APPLICATION)

  relatedTrackingNumber String?

  status ClientApplicationStatus @default(DRAFT)

  reviewedByUserId String?

  reviewRemarks                 String?
  additionalRequirementsRemarks String?
  rejectionReason               String?

  // Once accepted by DENR Records,
  // this can point to the actual eDATS document.
  documentId        String?   @unique
  document          Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  serviceTypeId     String?
  receivingOfficeId String?

  receivingOffice Office? @relation(fields: [receivingOfficeId], references: [id], onDelete: SetNull)

  serviceType ClientServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)

  attachments ClientApplicationAttachment[]

  submittedAt   DateTime?
  resubmittedAt DateTime?
  reviewedAt    DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([serviceTypeId])
  @@index([kind])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([createdAt])
}

model ClientApplicationAttachment {
  id String @id @default(cuid())

  applicationId String

  application ClientApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type          ClientApplicationAttachmentType @default(SUPPORTING_DOCUMENT)
  requirementId String?

  requirement ClientServiceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  fileName     String
  originalName String
  filePath     String
  mimeType     String
  fileSize     Int?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([type])
  @@index([requirementId])
}

model ClientServiceType {
  id String @id @default(cuid())

  code String @unique
  name String

  description String?

  kind ClientApplicationKind

  requiresLetterRequest  Boolean                    @default(false)
  requiresTrackingNumber Boolean                    @default(false)
  allowsAttachments      Boolean                    @default(true)
  requirements           ClientServiceRequirement[]

  isActive Boolean @default(true)

  receivingOfficeId String?
  receivingOffice   Office? @relation(fields: [receivingOfficeId], references: [id], onDelete: SetNull)

  applications ClientApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([isActive])
  @@index([receivingOfficeId])
}

model ClientServiceRequirement {
  id String @id @default(cuid())

  serviceTypeId String
  serviceType   ClientServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?

  isRequired     Boolean @default(true)
  allowsMultiple Boolean @default(false)
  isActive       Boolean @default(true)

  attachments ClientApplicationAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceTypeId, code])
  @@index([serviceTypeId])
  @@index([isActive])
}

model DocumentTrackingCounter {
  year       Int @id
  lastNumber Int @default(0)

  updatedAt DateTime @updatedAt
}
